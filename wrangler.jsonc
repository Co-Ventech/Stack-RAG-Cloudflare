{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-rag-tool",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "83c4915444a245599d83d93b1322d3ea"
    },
    {
      "binding": "DOCS_KV",
      "id": "b9a475115e144001abc47bdf6c5dc953"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "cf-rag-tool-index",
      "remote": true
    }
  ]
}
